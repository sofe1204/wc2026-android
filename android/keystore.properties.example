# Copy to android/keystore.properties and fill in your values.
# Create the keystore first:
#   keytool -genkeypair -v -keystore ~/wc2026-release.keystore -alias wc2026-release \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
# Build signed release bundle:
#   cd android && ./gradlew bundleRelease
# Output: app/build/outputs/bundle/release/app-release.aab

storeFile=/Users/YOUR_USER/wc2026-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=wc2026-release
keyPassword=YOUR_KEY_PASSWORD
