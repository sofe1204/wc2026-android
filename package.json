{
  "name": "world-cup-2026",
  "private": true,
  "scripts": {
    "generate:seed": "python3 scripts/generate_seed_data.py",
    "import:official-squads": "python3 scripts/import_official_wc2026_squads.py",
    "sync:clubs": "node scripts/sync_player_clubs.mjs",
    "populate:ratings": "node scripts/populate_player_ratings.mjs --enrich",
    "export:unmatched": "node scripts/export_unmatched_players.mjs",
    "build:overrides": "node scripts/build_ratings_overrides.mjs",
    "fill:ratings-empty": "node scripts/fill_empty_ratings.mjs",
    "ratings:complete": "node scripts/export_unmatched_players.mjs && node scripts/build_ratings_overrides.mjs && node scripts/populate_player_ratings.mjs --enrich && node scripts/fill_empty_ratings.mjs && node scripts/enrich_player_ratings.mjs && node scripts/verify_ratings_no_regression.mjs",
    "data:full": "python3 scripts/generate_seed_data.py && node scripts/populate_player_ratings.mjs && node scripts/fill_empty_ratings.mjs && python3 scripts/enrich_player_ratings.py",
    "validate:squads": "node scripts/validate_squads.mjs",
    "sync": "python3 scripts/sync_project.py",
    "sync:seed": "python3 scripts/generate_seed_data.py && python3 scripts/sync_project.py",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "bash scripts/deploy_functions.sh",
    "update:sticker-prompts": "node scripts/update_sticker_prompts.mjs",
    "generate:sticker-images": "node scripts/generate_sticker_images.mjs",
    "go-live:check": "node scripts/prep_go_live.mjs",
    "go-live:images:pilot": "node scripts/generate_sticker_images.mjs --limit 5 --concurrency 2",
    "go-live:images": "node scripts/generate_sticker_images.mjs --concurrency 2",
    "go-live:images:emblems": "node scripts/generate_sticker_images.mjs --emblems-only --concurrency 2",
    "edit:stickers-grok": "node scripts/edit_stickers_grok.mjs --concurrency 2",
    "go-live:edit-grok:pilot": "node scripts/edit_stickers_grok.mjs --limit 5 --concurrency 2",
    "go-live:edit-grok": "node scripts/edit_stickers_grok.mjs --concurrency 2",
    "retry:stickers-grok": "node scripts/edit_stickers_grok.mjs --player-ids-file data/grok_sticker_retry_queue.json --concurrency 1",
    "upload:emblems": "node scripts/upload_emblems.mjs",
    "go-live:emblems": "node scripts/upload_emblems.mjs",
    "upload:slot-symbols": "node scripts/upload_slot_symbols.mjs",
    "go-live:slot-symbols": "node scripts/upload_slot_symbols.mjs",
    "go-live:publish": "node scripts/seed_firestore.mjs",
    "deploy:storage": "firebase deploy --only storage",
    "seed:firestore": "node scripts/seed_firestore.mjs",
    "admin:claim": "node scripts/set_admin_claim.mjs",
    "setup:auth-users": "bash scripts/setup_authenticated_users.sh"
  }
}
