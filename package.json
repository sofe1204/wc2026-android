{
  "name": "world-cup-2026",
  "private": true,
  "scripts": {
    "generate:seed": "node scripts/generate_seed_data.mjs",
    "populate:ratings": "node scripts/populate_player_ratings.mjs --enrich",
    "export:unmatched": "node scripts/export_unmatched_players.mjs",
    "build:overrides": "node scripts/build_ratings_overrides.mjs",
    "fill:ratings-empty": "node scripts/fill_empty_ratings.mjs",
    "ratings:complete": "node scripts/export_unmatched_players.mjs && node scripts/build_ratings_overrides.mjs && node scripts/populate_player_ratings.mjs --enrich && node scripts/fill_empty_ratings.mjs && node scripts/enrich_player_ratings.mjs && node scripts/verify_ratings_no_regression.mjs",
    "data:full": "node scripts/generate_seed_data.mjs && node scripts/populate_player_ratings.mjs --enrich",
    "validate:squads": "node scripts/validate_squads.mjs",
    "sync": "python3 scripts/sync_project.py",
    "sync:seed": "python3 scripts/generate_seed_data.py && python3 scripts/sync_project.py",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "bash scripts/deploy_functions.sh"
  }
}
