# fal.ai — https://fal.ai/dashboard/keys (~$60 credits for full album)
FAL_KEY=

# Image model (default: Imagen 4 preview, 3:4, ~$0.04/image)
# FAL_MODEL=fal-ai/imagen4/preview
# FAL_MODEL=fal-ai/imagen4/preview/fast
# FAL_MODEL=fal-ai/flux/schnell

# Optional: same seed for every image (integer)
# STICKER_IMAGE_SEED=42

# Firebase Storage upload (or: gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
