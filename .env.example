# fal.ai — https://fal.ai/dashboard/keys (~$60 credits for full album)
FAL_KEY=

# Recommended: master sticker URL(s) → auto-uses FLUX Kontext edit (~$0.04/image)
# STICKER_MASTER_IMAGE_URL=https://storage.googleapis.com/your-bucket/stickers/master_outfield.jpg
# STICKER_MASTER_GK_IMAGE_URL=https://storage.googleapis.com/your-bucket/stickers/master_goalkeeper.jpg

# Image model (default: Kontext if master URL set, else Imagen 4 preview)
# FAL_MODEL=fal-ai/flux-pro/kontext
# FAL_MODEL=fal-ai/imagen4/preview

# Optional: same seed for every image (integer)
# STICKER_IMAGE_SEED=42

# Firebase Storage upload (or: gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
